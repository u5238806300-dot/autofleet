parameters:
    level: 8

    paths:
        - assets
        - commands
        - controllers
        - mail
        - models
        - widgets
        - tests/Acceptance
        - tests/Functional
        - tests/Unit
        - modules/api/controllers
        - services
        - repositories
        - jobs

    excludePaths:
        - vendor
        - tests
        - runtime

    scanDirectories:
        - tests/Support

    bootstrapFiles:
        - tests/_bootstrap.php

    dynamicConstantNames:
        - YII_DEBUG
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST

    ignoreErrors:
        - '#Unsafe usage of new static\(\).#'

    tmpDir: %currentWorkingDirectory%/runtime
